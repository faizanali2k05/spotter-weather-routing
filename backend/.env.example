# Spotter Weather-Aware Routing Backend Environment Configuration

# Django Secret Key (required in production; generate a strong 50+ character random key)
DJANGO_SECRET_KEY=replace-with-long-random-secret-key-for-production

# Debug Mode (set to false in production)
DEBUG=false

# Allowed Hosts (comma-separated domains/IPs; Render adds .onrender.com automatically)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS Allowed Origins (comma-separated origins for web client access)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://spotter-weather-routing.vercel.app

# Optional: Run live integration tests (0 = disabled, 1 = enabled)
RUN_LIVE_TESTS=0
