# ==============================================================================
# Spotter Weather-Aware Truck Routing — Environment Configuration Example
# ==============================================================================

# Backend (Django / Render) Configuration
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-secure-random-key-for-production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://spotter-weather-routing.vercel.app

# Optional Backend Settings
RUN_LIVE_TESTS=0

# Frontend (React Vite / Vercel) Configuration
# ------------------------------------------------------------------------------
# Point to your local Django server in dev, or Render service URL in production
VITE_API_BASE_URL=http://localhost:8000

